# 复制为 .env 后按需填写（.env 已被 .gitignore 忽略）。不要把真实 Cookie 写进仓库。
CAMPUS_EDU_BASE_URL=https://jw.example.edu.cn/jsxsd/
CAMPUS_EDU_VENDOR=qiangzhi
CAMPUS_EDU_SCHOOL=example-qiangzhi
# keyring 不可用时，指向本地 Cookie 文件（每次启动读取）
CAMPUS_EDU_COOKIE_FILE=
# 数据目录（默认：Windows %APPDATA%\campus-edu-mcp，Linux ~/.local/share/campus-edu-mcp）
CAMPUS_EDU_DATA_DIR=
# 两次请求的最小间隔秒数
CAMPUS_EDU_MIN_INTERVAL=2
